# Superusuário do cluster: bootstrap e Keycloak. A aplicação NÃO usa este papel
# — superusuário ignora Row-Level Security (ADR 0010).
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal_local_only
POSTGRES_DB=portal
# Senhas dos papéis criados por infra/postgres/bootstrap/roles.sql.
POSTGRES_APP_PASSWORD=portal_app_local_only
POSTGRES_SYSTEM_PASSWORD=portal_system_local_only
POSTGRES_MIGRATOR_PASSWORD=portal_migrator_local_only
POSTGRES_ADMIN_PASSWORD=portal_admin_local_only
# Uma URL por papel. DATABASE_URL é o caminho de requisição e precisa continuar
# em portal_app, o papel a que as policies se aplicam.
DATABASE_URL=postgresql+psycopg://portal_app:portal_app_local_only@postgres:5432/portal
DATABASE_SYSTEM_URL=postgresql+psycopg://portal_system:portal_system_local_only@postgres:5432/portal
DATABASE_MIGRATION_URL=postgresql+psycopg://portal_migrator:portal_migrator_local_only@postgres:5432/portal
# Único papel com escrita em `membership` — convite e revogação (ADR 0011).
DATABASE_ADMIN_URL=postgresql+psycopg://portal_admin:portal_admin_local_only@postgres:5432/portal
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=portal-minio
MINIO_ROOT_PASSWORD=portal-minio-local-only
MINIO_ENDPOINT=http://minio:9000
# Storage dos documentos (Fase 4, ADR 0014). Local aponta para o MinIO acima; em
# produção troque endpoint e credenciais pelo S3. Sem credencial o upload
# responde 503 — falha fechada, para não existir metadado sem arquivo.
STORAGE_ENDPOINT_URL=http://minio:9000
# O mesmo MinIO pelo endereço que o navegador alcança, para a URL assinada de
# download (ADR 0017). Dois endereços para um serviço, como o Keycloak: a API
# fala pela rede interna, e quem abre o link está fora dela. Em produção com
# S3 os dois coincidem e este pode ficar vazio.
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=portal-documents
STORAGE_ACCESS_KEY=portal-minio
STORAGE_SECRET_KEY=portal-minio-local-only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_only
# OIDC (ADR 0010). O `iss` é o endereço que o NAVEGADOR usa para logar; o JWKS é
# buscado pela rede interna do compose. São dois hosts diferentes de propósito.
OIDC_ISSUER=http://localhost:8080/realms/portal-local
OIDC_JWKS_URL=http://keycloak:8080/realms/portal-local/protocol/openid-connect/certs
OIDC_AUDIENCE=portal-api
# BFF como cliente OIDC (Auth.js v5). AUTH_SECRET cifra o cookie de sessão —
# em qualquer ambiente que não seja local, gere com `openssl rand -base64 32`.
AUTH_SECRET=portal_auth_local_only
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=portal-web
AUTH_KEYCLOAK_SECRET=portal-web-local-only
# Mesma separação do par OIDC_ISSUER/OIDC_JWKS_URL acima: o navegador é mandado
# para o endereço público (que vira o `iss`), e o BFF troca o código por token
# pelo endereço interno da rede do compose.
KEYCLOAK_ISSUER=http://localhost:8080/realms/portal-local
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/portal-local
# Convite de acesso (ADR 0011). O portal fala com o Admin API do realm por dentro
# da rede; o e-mail em si é mandado pelo Keycloak, via SMTP do realm (Mailpit).
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_REALM=portal-local
KEYCLOAK_ADMIN_CLIENT_ID=portal-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=portal-admin-local-only
PORTAL_WEB_URL=http://localhost:3000
DEMO_MODE=false
WEB_ORIGIN=http://localhost:3000
# Integração Biahflow (ADR 0006). O usuário do portal vem do seed, alinhado ao
# realm (apps/api/src/portal_api/seed.py) — não de variável de ambiente.
# BIAHFLOW_BASE_URL aponta para a API do Biahflow (repo/stack separado).
BIAHFLOW_BASE_URL=http://localhost:19000/api/v1
BIAHFLOW_READ_TOKEN=
BIAHFLOW_WEBHOOK_SECRET=
# Notificações por e-mail (Fase 2, ADR 0012). Local é o Mailpit do compose
# (caixa em http://localhost:8025); em produção troque host/porta/credenciais
# pelo SMTP do provedor. SMTP_USER vazio = sem autenticação, como o Mailpit.
NOTIFICATIONS_EMAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
NOTIFICATIONS_FROM_EMAIL=portal@portallabs.local
NOTIFICATIONS_FROM_NAME=Portal Labs
# API de eventos dos agentes (Fase 3, ADR 0013). Entra no HMAC que substitui a
# chave no banco — trocar este valor invalida todas as chaves emitidas. Vazio =
# nenhuma chave autentica (falha fechada). Em produção, gere um segredo próprio.
AGENT_KEY_PEPPER=agent-pepper-local-only
# Requisições por chave por minuto, em janela deslizante.
AGENT_EVENTS_RATE_LIMIT=120
# Chat contextual (Fase 3, ADR 0007). Vazio = respondedor offline determinístico.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Índice do projeto (Fase 4, ADR 0014). Vazio = embedder offline determinístico,
# na mesma dimensão da coluna: a stack sobe e indexa sem chave nenhuma.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
# Conector do Google Drive (Fase 4, ADR 0016). Sem client id/secret o portal
# responde 503 nas rotas do conector — aqui não existe caminho offline que
# signifique algo, então a falha é fechada como a do storage.
#
# Local aponta para o `drive-stub` do compose. Os dois endereços diferentes não
# são engano: o NAVEGADOR vai ao authorize (localhost) e o SERVIDOR vai ao token
# e à API (rede interna) — a mesma separação de OIDC_ISSUER/OIDC_JWKS_URL. Em
# produção só estas quatro mudam, e o redirect precisa estar registrado no
# console do Google **byte a byte** igual.
GOOGLE_DRIVE_CLIENT_ID=portal-drive-local
GOOGLE_DRIVE_CLIENT_SECRET=portal-drive-local-only
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/admin/conhecimento/drive-callback
GOOGLE_OAUTH_AUTHORIZE_URL=http://localhost:19100/authorize
GOOGLE_OAUTH_TOKEN_URL=http://drive-stub:19100/token
GOOGLE_DRIVE_API_BASE_URL=http://drive-stub:19100/drive/v3
# Cifra o refresh token no banco (AES-256-GCM, 32 bytes em base64url). Ela protege
# o banco, então não pode viver nele. Vazia = nenhuma conexão do Drive funciona.
# Gere a sua com: python -c "from portal_api.crypto import generate_key; print(generate_key())"
DRIVE_TOKEN_ENCRYPTION_KEY=cG9ydGFsLWxhYnMtbG9jYWwtb25seS1kcml2ZS1rZXk
# Durante uma rotação, a chave anterior continua abrindo o que ela selou — sem
# isso, girar a chave obrigaria cada projeto a refazer o consentimento no Google.
DRIVE_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# O beat só acorda com isto ligado. Uma stack sem credencial não deve bater no
# Google a cada 15 minutos para falhar.
DRIVE_SYNC_ENABLED=true
DRIVE_SYNC_INTERVAL_SECONDS=900
# Varredura antimalware (Fase 5, ADR 0017). Vazio = veredito `skipped`, e nunca
# `clean`: um scanner ausente não afirma que o arquivo está limpo. O caminho sem
# ClamAV ainda reconhece a assinatura EICAR, que é o que permite ao e2e provar a
# rejeição sem antivírus — como o `drive-stub` prova o Drive sem o Google.
# Em produção, aponte para o daemon: CLAMAV_HOST=clamav
CLAMAV_HOST=
CLAMAV_PORT=3310
# Validade da URL assinada de download. Curta de propósito: a URL não carrega
# sessão, então o que limita o estrago de um vazamento é ela vencer.
DOCUMENT_DOWNLOAD_TTL_SECONDS=300
# Retenção (Fase 5, ADR 0017). Ligada por padrão, ao contrário do sync do Drive:
# ela só precisa do próprio banco. Os prazos abaixo são o padrão; cada
# organização pode ter os seus em `organization_retention_policy`.
RETENTION_ENABLED=true
RETENTION_NOTIFICATION_DAYS=180
RETENTION_AGENT_EVENT_DAYS=730
RETENTION_CONVERSATION_DAYS=365
# Telemetria (Fase 5, ADR 0018). `json` é o formato que um coletor lê e o que o
# runbook de incidente pressupõe; `text` dá a linha legível do dia a dia — e
# **também** imprime os campos de `extra`, que descartá-los era o defeito, não uma
# escolha de formato.
LOG_LEVEL=INFO
LOG_FORMAT=json
# BFF (frontend) → FastAPI, server-side (não use NEXT_PUBLIC_/VITE_).
API_BASE_URL=http://api:8000
