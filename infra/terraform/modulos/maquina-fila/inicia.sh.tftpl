#cloud-config
# Sobe o Redis e os processos longos como contêineres, em unidades do systemd.
#
# `Restart=always` em todos: uma fila que morre e não volta é pior que uma fila
# que nunca subiu, porque a segunda é visível no primeiro teste e a primeira só
# aparece quando alguém repara que o digest parou de sair.

write_files:
  - path: /etc/systemd/system/redis.service
    content: |
      [Unit]
      Description=Redis (broker do Celery e cache do Django)
      After=docker.service
      Requires=docker.service

      [Service]
      Restart=always
      RestartSec=5
      ExecStartPre=-/usr/bin/docker rm -f redis
      ExecStart=/usr/bin/docker run --rm --name redis \
        --publish 6379:6379 \
        --volume /var/lib/redis:/data \
        redis:7-alpine redis-server --appendonly yes
      ExecStop=/usr/bin/docker stop redis

      [Install]
      WantedBy=multi-user.target

%{ for nome, comando in processos ~}
  - path: /etc/systemd/system/${nome}.service
    content: |
      [Unit]
      Description=${nome}
      After=redis.service
      Requires=redis.service

      [Service]
      Restart=always
      RestartSec=10
      ExecStartPre=-/usr/bin/docker rm -f ${nome}
      ExecStartPre=/usr/bin/docker-credential-gcr configure-docker --registries=${split("/", imagem)[0]}
      ExecStartPre=/usr/bin/docker pull ${imagem}
      ExecStart=/usr/bin/docker run --rm --name ${nome} \
        --network host \
        --env-file /run/hml.env \
        ${imagem} ${comando}
      ExecStop=/usr/bin/docker stop ${nome}

      [Install]
      WantedBy=multi-user.target

%{ endfor ~}
  # Os segredos são buscados no boot e vivem em `/run`, que é tmpfs — some no
  # reinício e nunca toca o disco. O arquivo é 0600 e do root.
  - path: /etc/systemd/system/hml-segredos.service
    content: |
      [Unit]
      Description=Busca os segredos no Secret Manager
      Before=${join(".service ", keys(processos))}.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/bin/bash /opt/hml/segredos.sh

      [Install]
      WantedBy=multi-user.target

  - path: /opt/hml/segredos.sh
    permissions: "0700"
    content: |
      #!/bin/bash
      set -euo pipefail
      umask 077
      : > /run/hml.env
      # As variáveis simples, que não são segredo.
%{ for chave, valor in variaveis ~}
      echo '${chave}=${valor}' >> /run/hml.env
%{ endfor ~}
      # E os segredos, pelo metadata server — sem chave no ambiente, que é a
      # razão de a VM ter conta de serviço em vez de credencial montada.
      TOKEN=$(curl -sf -H 'Metadata-Flavor: Google' \
        'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
        | python3 -c 'import sys,json; print(json.load(sys.stdin)["access_token"])')
%{ for nome in segredos ~}
      VALOR=$(curl -sf -H "Authorization: Bearer $TOKEN" \
        'https://secretmanager.googleapis.com/v1/projects/${projeto}/secrets/${nome}/versions/latest:access' \
        | python3 -c 'import sys,json,base64; print(base64.b64decode(json.load(sys.stdin)["payload"]["data"]).decode())')
      echo "${nome}=$VALOR" >> /run/hml.env
%{ endfor ~}
      chmod 600 /run/hml.env

runcmd:
  - mkdir -p /var/lib/redis
  - systemctl daemon-reload
  - systemctl enable --now redis.service hml-segredos.service
%{ for nome, _ in processos ~}
  - systemctl enable --now ${nome}.service
%{ endfor ~}
