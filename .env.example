# Superusuário do cluster: bootstrap e Keycloak. A aplicação NÃO usa este papel
# — superusuário ignora Row-Level Security (ADR 0010).
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal_local_only
POSTGRES_DB=portal
# Senhas dos papéis criados por infra/postgres/bootstrap/roles.sql.
POSTGRES_APP_PASSWORD=portal_app_local_only
POSTGRES_SYSTEM_PASSWORD=portal_system_local_only
POSTGRES_MIGRATOR_PASSWORD=portal_migrator_local_only
POSTGRES_ADMIN_PASSWORD=portal_admin_local_only
# Uma URL por papel. DATABASE_URL é o caminho de requisição e precisa continuar
# em portal_app, o papel a que as policies se aplicam.
DATABASE_URL=postgresql+psycopg://portal_app:portal_app_local_only@postgres:5432/portal
DATABASE_SYSTEM_URL=postgresql+psycopg://portal_system:portal_system_local_only@postgres:5432/portal
DATABASE_MIGRATION_URL=postgresql+psycopg://portal_migrator:portal_migrator_local_only@postgres:5432/portal
# Único papel com escrita em `membership` — convite e revogação (ADR 0011).
DATABASE_ADMIN_URL=postgresql+psycopg://portal_admin:portal_admin_local_only@postgres:5432/portal
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=portal-minio
MINIO_ROOT_PASSWORD=portal-minio-local-only
MINIO_ENDPOINT=http://minio:9000
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_only
# OIDC (ADR 0010). O `iss` é o endereço que o NAVEGADOR usa para logar; o JWKS é
# buscado pela rede interna do compose. São dois hosts diferentes de propósito.
OIDC_ISSUER=http://localhost:8080/realms/portal-local
OIDC_JWKS_URL=http://keycloak:8080/realms/portal-local/protocol/openid-connect/certs
OIDC_AUDIENCE=portal-api
# BFF como cliente OIDC (Auth.js v5). AUTH_SECRET cifra o cookie de sessão —
# em qualquer ambiente que não seja local, gere com `openssl rand -base64 32`.
AUTH_SECRET=portal_auth_local_only
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=portal-web
AUTH_KEYCLOAK_SECRET=portal-web-local-only
# Mesma separação do par OIDC_ISSUER/OIDC_JWKS_URL acima: o navegador é mandado
# para o endereço público (que vira o `iss`), e o BFF troca o código por token
# pelo endereço interno da rede do compose.
KEYCLOAK_ISSUER=http://localhost:8080/realms/portal-local
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/portal-local
DEMO_MODE=false
WEB_ORIGIN=http://localhost:3000
# Integração Biahflow (ADR 0006). O usuário do portal vem do seed, alinhado ao
# realm (apps/api/src/portal_api/seed.py) — não de variável de ambiente.
# BIAHFLOW_BASE_URL aponta para a API do Biahflow (repo/stack separado).
BIAHFLOW_BASE_URL=http://localhost:19000/api/v1
BIAHFLOW_READ_TOKEN=
BIAHFLOW_WEBHOOK_SECRET=
# Chat contextual (Fase 3, ADR 0007). Vazio = respondedor offline determinístico.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# BFF (frontend) → FastAPI, server-side (não use NEXT_PUBLIC_/VITE_).
API_BASE_URL=http://api:8000
