# Homologação (Fase 5, ADR 0022) — a lista completa do que o ambiente exige.
#
#   cp .env.homolog.example .env      # e então troque **todo** CHANGEME
#   docker compose -f docker-compose.yml -f docker-compose.homolog.yml up -d
#
# Este arquivo é o par do `docker-compose.homolog.yml`: lá toda variável de
# segredo é `${VAR:?}`, e aqui está o que preencher. `test_homolog_config.py`
# cobra a correspondência nos dois sentidos — variável exigida pelo compose e
# ausente daqui reprova, e o contrário também.
#
# **Este arquivo não é uma configuração; é a forma de uma.** Todo valor traz
# `CHANGEME`, que é uma das sentinelas do `portal_api/preflight.py`: um `.env`
# derivado daqui e preenchido pela metade **não sobe**. Isso é deliberado, e
# fecha o buraco que a exigência do compose deixa aberta — `${VAR:?}` só sabe
# perguntar se a variável tem valor, nunca se o valor é seu.
#
# O runbook de subida, com a origem e a rotação de cada segredo, é
# `docs/runbooks/deploy.md`.

# ---------------------------------------------------------------------------
# Identidade do ambiente
# ---------------------------------------------------------------------------
# Qualquer coisa diferente de `local` liga as recusas do `preflight`.
ENVIRONMENT=homolog

# ---------------------------------------------------------------------------
# Domínios e TLS (o Caddy cuida do certificado; ver infra/caddy/Caddyfile)
# ---------------------------------------------------------------------------
PORTAL_DOMAIN=portal.CHANGEME.example
KEYCLOAK_DOMAIN=auth.CHANGEME.example
PORTAL_PUBLIC_URL=https://portal.CHANGEME.example
KEYCLOAK_PUBLIC_URL=https://auth.CHANGEME.example

# ---------------------------------------------------------------------------
# Postgres — cinco senhas, uma por papel (ADR 0010/0011)
# ---------------------------------------------------------------------------
# `portal` é o dono do banco; os quatro papéis abaixo são o desenho de tenancy
# inteiro, e é por eles que o `restore.sh` consegue afirmar que a RLS voltou.
POSTGRES_USER=portal
POSTGRES_DB=portal
POSTGRES_PASSWORD=CHANGEME
POSTGRES_APP_PASSWORD=CHANGEME
POSTGRES_SYSTEM_PASSWORD=CHANGEME
POSTGRES_MIGRATOR_PASSWORD=CHANGEME
POSTGRES_ADMIN_PASSWORD=CHANGEME

# As mesmas senhas, na forma que a aplicação lê. Precisam bater com as de cima:
# quem escreve uma e esquece a outra descobre no primeiro `up`.
DATABASE_URL=postgresql+psycopg://portal_app:CHANGEME@postgres:5432/portal
DATABASE_SYSTEM_URL=postgresql+psycopg://portal_system:CHANGEME@postgres:5432/portal
DATABASE_MIGRATION_URL=postgresql+psycopg://portal_migrator:CHANGEME@postgres:5432/portal
DATABASE_ADMIN_URL=postgresql+psycopg://portal_admin:CHANGEME@postgres:5432/portal

# ---------------------------------------------------------------------------
# Keycloak e OIDC
# ---------------------------------------------------------------------------
# O realm de homologação é criado uma vez, pelo runbook — o `portal-local` do
# repositório traz `sslRequired: none` e senhas conhecidas, e não entra aqui.
KEYCLOAK_REALM=portal-homolog
KEYCLOAK_ADMIN=CHANGEME
KEYCLOAK_ADMIN_PASSWORD=CHANGEME
KEYCLOAK_ADMIN_CLIENT_ID=portal-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGEME
# O `iss` do token é o endereço que o NAVEGADOR usou; o JWKS é buscado pela rede
# interna. Os dois endereços diferentes são a ADR 0010, não um engano.
OIDC_ISSUER=https://auth.CHANGEME.example/realms/portal-homolog
OIDC_JWKS_URL=http://keycloak:8080/realms/portal-homolog/protocol/openid-connect/certs
OIDC_AUDIENCE=portal-api
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/portal-homolog

# ---------------------------------------------------------------------------
# BFF (Auth.js)
# ---------------------------------------------------------------------------
# `openssl rand -base64 32`. Trocá-lo desloga todo mundo — é a chave do cookie.
AUTH_SECRET=CHANGEME
AUTH_KEYCLOAK_ID=portal-web
AUTH_KEYCLOAK_SECRET=CHANGEME

# ---------------------------------------------------------------------------
# Biahflow — a fonte da verdade do status (ADR 0006)
# ---------------------------------------------------------------------------
BIAHFLOW_BASE_URL=https://CHANGEME.example/api/v1
BIAHFLOW_READ_TOKEN=CHANGEME
BIAHFLOW_WEBHOOK_SECRET=CHANGEME

# ---------------------------------------------------------------------------
# E-mail — em homologação o convite precisa chegar a uma pessoa de verdade
# ---------------------------------------------------------------------------
NOTIFICATIONS_EMAIL_ENABLED=true
SMTP_HOST=CHANGEME.example
SMTP_PORT=587
SMTP_USER=CHANGEME
SMTP_PASSWORD=CHANGEME
SMTP_STARTTLS=true
NOTIFICATIONS_FROM_EMAIL=portal@CHANGEME.example

# ---------------------------------------------------------------------------
# Storage (ADR 0014/0017)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
STORAGE_ACCESS_KEY=CHANGEME
STORAGE_SECRET_KEY=CHANGEME
# A assinatura da URL de download cobre o host, então este é o endereço pelo
# qual o NAVEGADOR abre o arquivo — não o interno.
STORAGE_PUBLIC_ENDPOINT_URL=https://storage.CHANGEME.example

# ---------------------------------------------------------------------------
# Varredura (ADR 0017) — `skipped` não é `clean`
# ---------------------------------------------------------------------------
CLAMAV_HOST=clamav

# ---------------------------------------------------------------------------
# Chave de agente (ADR 0013)
# ---------------------------------------------------------------------------
# Entra no HMAC que substitui a chave no banco. Trocá-lo invalida **todas** as
# chaves emitidas, o que é a forma de revogar tudo de uma vez.
AGENT_KEY_PEPPER=CHANGEME

# ---------------------------------------------------------------------------
# Google Drive (ADR 0016)
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=CHANGEME
GOOGLE_DRIVE_CLIENT_SECRET=CHANGEME
GOOGLE_DRIVE_REDIRECT_URI=https://portal.CHANGEME.example/admin/knowledge/drive-callback
# Protege o refresh token no banco, então não pode viver no banco.
# `openssl rand -base64 32`. Ao rotacionar, a anterior vai em
# DRIVE_TOKEN_ENCRYPTION_KEY_PREVIOUS para ninguém precisar reconsentir.
DRIVE_TOKEN_ENCRYPTION_KEY=CHANGEME
DRIVE_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# IA (ADR 0007/0014/0021)
# ---------------------------------------------------------------------------
# Sem estas duas o portal responde pelo casador offline, sem citar documento e
# **sem erro nenhum no log** — um portal que parece funcionar e responde pior.
ANTHROPIC_API_KEY=CHANGEME
ANTHROPIC_MODEL=claude-opus-5
VOYAGE_API_KEY=CHANGEME
VOYAGE_MODEL=voyage-3
CHAT_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# Telemetria (ADR 0018) — `json` é o que um coletor lê
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Backup (ADR 0019) — sem destinatário, o script recusa em vez de cifrar nada
# ---------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_AGE_RECIPIENT=CHANGEME
