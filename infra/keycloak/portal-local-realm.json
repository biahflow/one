{
  "realm": "portal-local",
  "enabled": true,
  "displayName": "Portal Labs (Local)",
  "sslRequired": "none",
  "bruteForceProtected": true,
  "quickLoginCheckMilliSeconds": 0,
  "failureFactor": 30,
  "roles": {
    "realm": [
      {
        "name": "internal_admin"
      },
      {
        "name": "internal_member"
      },
      {
        "name": "client_member"
      }
    ]
  },
  "clients": [
    {
      "clientId": "portal-web",
      "name": "Portal Labs local web (BFF)",
      "enabled": true,
      "publicClient": false,
      "secret": "portal-web-local-only",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak",
        "http://localhost:3000/login"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/login"
      },
      "protocolMappers": [
        {
          "name": "portal-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "portal-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "portal-api",
      "name": "Portal Labs API (resource server)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "portal-admin",
      "name": "Portal Labs API (convite de acesso)",
      "description": "Service account usado só para criar usuario e disparar o e-mail de convite.",
      "enabled": true,
      "publicClient": false,
      "secret": "portal-admin-local-only",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
